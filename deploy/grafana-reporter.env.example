DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
APP_ENCRYPTION_KEY=replace-with-a-fernet-key
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=reports.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://reports.example.com
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
PUBLIC_BASE_URL=https://reports.example.com

DATABASE_URL=postgresql://grafana_reporter:replace-password@127.0.0.1:5432/grafana_reporter
REDIS_URL=redis://127.0.0.1:6379/0
REPORT_ROOT=/srv/grafana-reporter/reports
STATIC_ROOT=/srv/grafana-reporter/staticfiles
USE_X_ACCEL_REDIRECT=true

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-user
EMAIL_HOST_PASSWORD=replace-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=grafana-reporter@example.com
LOG_LEVEL=INFO
