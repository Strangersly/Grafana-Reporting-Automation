{
  "grafana": {
    "base_url": "https://monitoring.ilcs.co.id/",
    "login_path": "/login",
    "username_env": "GRAFANA_USERNAME",
    "password_env": "GRAFANA_PASSWORD",
    "org_id": 1,
    "theme": "dark",
    "kiosk": true,
    "timezone": "Asia/Jakarta",
    "viewport": {
      "width": 3440,
      "height": 1220
    },
    "full_page": false,
    "wait_seconds": 8,
    "ignore_https_errors": false
  },
  "output": {
    "root": "D:/GrafanaReports",
    "folder_template": "{year}/{month_number}. {month_name}/{site}/{group}/{category}/{name}",
    "overwrite": true
  },
  "periods": {
    "target_month": "previous",
    "weekly_mode": "four_blocks"
  },
  "schedule": {
    "enabled": true,
    "poll_seconds": 60,
    "monthly": {
      "enabled": true,
      "day": 1,
      "time": "07:30",
      "capture": "previous_month",
      "include_weeklies": true
    },
    "weekly": {
      "enabled": false,
      "day": "monday",
      "time": "07:00",
      "capture": "previous_7_days"
    }
  },
