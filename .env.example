# Copy this file to .env and edit the values.
# Do not share or commit your real .env file.
# Local CLI credentials. The web app stores its Grafana service credentials
# encrypted through the admin settings screen.
GRAFANA_USERNAME=your-grafana-username
GRAFANA_PASSWORD=your-grafana-password

# Web application settings. Generate both keys before production deployment.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
# Blank is allowed only in local debug mode, where a development key is derived.
APP_ENCRYPTION_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
PUBLIC_BASE_URL=http://localhost:8000
REPORT_ROOT=reports

# Leave DATABASE_URL empty for local SQLite development.
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379/0

# Generic SMTP. The console backend is used automatically in debug mode.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=grafana-reporter@example.com
